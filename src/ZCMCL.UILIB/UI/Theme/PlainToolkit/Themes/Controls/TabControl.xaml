<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- TABCONTROL — clean tabs, accent underline for selected -->
    <Style TargetType="TabControl" x:Key="PlainTabControl">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource ColorBrush1}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid KeyboardNavigation.TabNavigation="Local">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <!-- Tab headers -->
                        <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Hidden" BorderThickness="0">
                            <TabPanel x:Name="HeaderPanel"
                                      IsItemsHost="True"
                                      KeyboardNavigation.TabIndex="1"
                                      Background="Transparent" />
                        </ScrollViewer>
                        <!-- Tab content -->
                        <Border Grid.Row="1"
                                Background="{DynamicResource ColorBrushWhite}"
                                BorderBrush="{DynamicResource ColorBrushGray6}"
                                BorderThickness="1"
                                CornerRadius="0,3,3,3"
                                Padding="10">
                            <ContentPresenter x:Name="PART_SelectedContentHost"
                                              ContentSource="SelectedContent"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- TABITEM -->
    <Style TargetType="TabItem" x:Key="PlainTabItem">
        <Setter Property="Foreground" Value="{DynamicResource ColorBrushGray3}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid SnapsToDevicePixels="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!-- Tab label -->
                        <Border x:Name="Bd" Grid.Column="0"
                                Background="{TemplateBinding Background}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="3,3,0,0">
                            <Grid>
                                <Border x:Name="HoverBg" Background="{DynamicResource ColorBrush8}"
                                        CornerRadius="3,3,0,0" Opacity="0" IsHitTestVisible="False" />
                                <ContentPresenter x:Name="Content"
                                                  ContentSource="Header"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True"
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                            </Grid>
                        </Border>
                        <!-- Separator | -->
                        <Border Grid.Column="1" x:Name="SeparatorLine"
                                Width="1" Height="14"
                                VerticalAlignment="Center"
                                Background="{DynamicResource ColorBrushGray5}"
                                Opacity="0.4" />
                        <!-- Selected underline (shorter than tab by 6px each side) -->
                        <Border x:Name="Underline"
                                Grid.ColumnSpan="2"
                                Height="2" Margin="6,0"
                                VerticalAlignment="Bottom"
                                Background="{DynamicResource ColorBrush2}"
                                Opacity="0"
                                CornerRadius="1,1,0,0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverBg"
                                            Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.1" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverBg"
                                            Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                            <Setter Property="Foreground" Value="{DynamicResource ColorBrush1}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource ColorBrush2}" />
                            <Setter TargetName="Underline" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource ColorBrushGray5}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TabControl" BasedOn="{StaticResource PlainTabControl}" />
    <Style TargetType="TabItem" BasedOn="{StaticResource PlainTabItem}" />

</ResourceDictionary>
