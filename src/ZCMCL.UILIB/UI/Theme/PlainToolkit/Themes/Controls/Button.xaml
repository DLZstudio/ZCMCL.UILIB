<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="Button" x:Key="PlainButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="False" />
        <Setter Property="UseLayoutRounding" Value="False" />
        <Setter Property="FontSize" Value="13" />

        <Setter Property="BorderBrush" Value="{DynamicResource ColorBrush1}" />
        <Setter Property="Background" Value="{DynamicResource ColorBrushTransparent}" />
        <Setter Property="Padding" Value="14,8" />
        <!--
            模板里的边框宽度改为 TemplateBinding 后，必须在此给默认值：
            Button.BorderThickness 的 WPF 默认是 0，不补这条会让所有 PlainButton 失去边框。
            ZCMCL 补：值为 1，与原硬编码一致。
        -->
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="PanBack"
                            Background="{DynamicResource ColorBrushSemiTransparent}">
                        <Grid>
                            <Border x:Name="HoverBg" Background="{DynamicResource ColorBrushButtonHoverBg}"
                                    CornerRadius="5" Opacity="0" IsHitTestVisible="False" />
                            <!--
                                ZCMCL 修复：BorderThickness 原本硬编码为 1，
                                控件上设 BorderThickness="0" 完全无效
                                （表现为「想做成无边框按钮，结果始终有 1px 框」）。
                                改为 TemplateBinding，尊重控件自身设置。
                            -->
                            <Border x:Name="PanFore" CornerRadius="5"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    Background="{TemplateBinding Background}"
                                    Padding="{TemplateBinding Padding}"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform />
                                </Border.RenderTransform>
                                <TextBlock x:Name="LabText"
                                           Text="{TemplateBinding Content}"
                                           TextOptions.TextFormattingMode="Display"
                                           SnapsToDevicePixels="True" TextTrimming="None"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           RenderTransformOrigin="0.5,0.5"
                                           Foreground="{Binding BorderBrush, ElementName=PanFore}"
                                           FontSize="{TemplateBinding FontSize}"
                                           IsHitTestVisible="False">
                                    <TextBlock.RenderTransform>
                                        <ScaleTransform />
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverBg"
                                            Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.1" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverBg"
                                            Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <!-- Pressed: scale animation (color-independent) -->
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PanFore"
                                            Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleX)"
                                            To="0.955" Duration="0:0:0.08" />
                                        <DoubleAnimation Storyboard.TargetName="PanFore"
                                            Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleY)"
                                            To="0.955" Duration="0:0:0.08" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PanFore"
                                            Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleX)"
                                            To="1" Duration="0:0:0.3" />
                                        <DoubleAnimation Storyboard.TargetName="PanFore"
                                            Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleY)"
                                            To="1" Duration="0:0:0.3" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <!-- Disabled -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="PanFore" Property="BorderBrush" Value="{DynamicResource ColorBrushGray4}" />
                            <Setter TargetName="PanFore" Property="Background" Value="{DynamicResource ColorBrushGray6}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource PlainButton}" />

</ResourceDictionary>
