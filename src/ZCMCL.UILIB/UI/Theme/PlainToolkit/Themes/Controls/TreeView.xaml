<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- TREEVIEW — Clean hierarchical list with accent selection bar -->
    <Style TargetType="TreeView" x:Key="PlainTreeView">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Background" Value="{DynamicResource ColorBrushTransparentBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ColorBrushGray5}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource ColorBrush1}" />
        <Setter Property="ItemContainerStyle" Value="{DynamicResource PlainTreeViewItem}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TreeView">
                    <Border BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="3">
                        <ScrollViewer Padding="4"
                                      Focusable="False"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Auto">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- TREEVIEWITEM — Full-row hover, accent left bar, animated chevron -->
    <Style TargetType="TreeViewItem" x:Key="PlainTreeViewItem">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource ColorBrush1}" />
        <Setter Property="Background" Value="{DynamicResource ColorBrushTransparent}" />
        <Setter Property="Padding" Value="4,3" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TreeViewItem">
                    <StackPanel>
                        <!-- Row: accent bar + hover + expander + content -->
                        <Border x:Name="RowBorder"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="3"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <!-- Hover overlay — full row -->
                                <Border x:Name="HoverBg"
                                        Background="{DynamicResource ColorBrush7}"
                                        CornerRadius="3"
                                        Opacity="0"
                                        IsHitTestVisible="False" />

                                <!-- Accent bar (left edge) -->
                                <Border x:Name="AccentBar"
                                        Width="3"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Stretch"
                                        Background="{DynamicResource ColorBrush3}"
                                        CornerRadius="2"
                                        Opacity="0"
                                        Margin="-4,0,0,0" />

                                <!-- Header row: chevron indicator + content -->
                                <StackPanel Orientation="Horizontal" Margin="4,0,0,0">
                                    <!-- Chevron expand indicator (visual only, not interactive) -->
                                    <Border x:Name="ChevronHost"
                                            Width="16" Height="16"
                                            Visibility="Collapsed"
                                            Margin="0,0,4,0"
                                            Background="Transparent"
                                            VerticalAlignment="Center">
                                        <Path x:Name="Chevron"
                                              Fill="{DynamicResource ColorBrushGray3}"
                                              Data="M3,5L8,10 13,5"
                                              Stroke="{DynamicResource ColorBrushGray3}"
                                              StrokeThickness="1.5"
                                              StrokeLineJoin="Round"
                                              Width="10" Height="8"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RenderTransformOrigin="0.5,0.5">
                                            <Path.RenderTransform>
                                                <RotateTransform Angle="0" />
                                            </Path.RenderTransform>
                                        </Path>
                                    </Border>

                                    <!-- Content -->
                                    <ContentPresenter x:Name="PART_Header"
                                                      ContentSource="Header"
                                                      VerticalAlignment="Center"
                                                      SnapsToDevicePixels="True" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Child items (indented) -->
                        <ItemsPresenter x:Name="ItemsHost" Visibility="Collapsed" Margin="18,0,0,0" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Chevron"
                                            Storyboard.TargetProperty="(Path.RenderTransform).(RotateTransform.Angle)"
                                            To="90" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Chevron"
                                            Storyboard.TargetProperty="(Path.RenderTransform).(RotateTransform.Angle)"
                                            To="0" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="HasItems" Value="True">
                            <Setter TargetName="ChevronHost" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="AccentBar" Property="Opacity" Value="1" />
                            <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource ColorBrush8}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverBg"
                                            Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.1" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverBg"
                                            Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TreeView" BasedOn="{StaticResource PlainTreeView}" />
    <Style TargetType="TreeViewItem" BasedOn="{StaticResource PlainTreeViewItem}" />

</ResourceDictionary>
