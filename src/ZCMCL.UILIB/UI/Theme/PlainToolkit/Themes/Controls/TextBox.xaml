<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:ZCMCL.UILIB.UI.Controls;assembly=ZCMCL.UILIB">

    <!-- TEXTBOX — PCL-CE MyTextBox style, border animates on hover/focus -->
    <Style TargetType="TextBox" x:Key="PlainTextBox">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{DynamicResource ColorBrushTransparent}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="SelectionBrush" Value="{DynamicResource ColorBrush3}" />
        <Setter Property="Foreground" Value="{DynamicResource ColorBrush1}" />

        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="None" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ScrollViewer.PanningMode" Value="VerticalFirst" />
        <Setter Property="BorderBrush" Value="{DynamicResource ColorBrushBg0}" />
        <Setter Property="CaretBrush" Value="{DynamicResource ColorBrush1}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="border"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5">
                            <Grid>
                                <Border x:Name="HoverOverlay"
                                        Background="{DynamicResource ColorBrushInputHoverBg}"
                                        BorderBrush="{DynamicResource ColorBrushInputHoverBorder}"
                                        BorderThickness="1" CornerRadius="5"
                                        Opacity="0" IsHitTestVisible="False" />
                                <Border x:Name="FocusOverlay"
                                        Background="{DynamicResource ColorBrushInputFocusBg}"
                                        BorderBrush="{DynamicResource ColorBrushInputFocusBorder}"
                                        BorderThickness="1" CornerRadius="5"
                                        Opacity="0" IsHitTestVisible="False" />
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="5,0,0,0" Cursor="IBeam"
                                              BorderThickness="0" />

                                <!--
                                    ZCMCL 补：水印（HintText）。
                                    PCL 的 MyTextBox 有 HintText，上游 PlainTextBox 没有，
                                    导致每个输入框都要在外部叠一层 TextBlock + TextChanged 手动显隐。
                                    这里由附加属性 ui:TextBoxHelper.HintText 驱动，Text 为空时显示。
                                -->
                                <TextBlock x:Name="Hint"
                                           Margin="6,0,0,0"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           Foreground="{DynamicResource ColorBrushGray3}"
                                           Text="{Binding Path=(ui:TextBoxHelper.HintText), RelativeSource={RelativeSource TemplatedParent}}"
                                           Visibility="Collapsed" />
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                            Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.1" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                            Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FocusOverlay"
                                            Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.1" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FocusOverlay"
                                            Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource ColorBrushGray5}" />
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource ColorBrushGray6}" />
                        </Trigger>
                        <!--
                            ZCMCL 补：水印显示条件（Text 为空且未聚焦时）。
                            加「未聚焦」是为避免光标停在空框里时水印仍显示、看起来像有内容。
                        -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Text" Value="" />
                                <Condition Property="IsKeyboardFocused" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Hint" Property="Visibility" Value="Visible" />
                        </MultiTrigger>
                        <!--
                            ZCMCL 补：错误态边框。
                            附加属性不能用 Trigger.Property 语法（MC4106），故用 DataTrigger 绑定。
                        -->
                        <DataTrigger Binding="{Binding Path=(ui:TextBoxHelper.HasError), RelativeSource={RelativeSource TemplatedParent}}"
                                     Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource ColorBrushRedDark}" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- PASSWORDBOX — PCL-CE style with animated hover/focus -->
    <Style TargetType="PasswordBox" x:Key="PlainPasswordBox">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="SelectionBrush" Value="{DynamicResource ColorBrush3}" />
        <Setter Property="Foreground" Value="{DynamicResource ColorBrush1}" />
        <Setter Property="Background" Value="{DynamicResource ColorBrushTransparent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ColorBrushBg0}" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="None" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="CaretBrush" Value="{DynamicResource ColorBrush1}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="border" BorderThickness="1"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="5" SnapsToDevicePixels="True">
                        <Grid>
                            <Border x:Name="HoverOverlay"
                                    Background="{DynamicResource ColorBrushInputHoverBg}"
                                    BorderBrush="{DynamicResource ColorBrushInputHoverBorder}"
                                    BorderThickness="1" CornerRadius="5"
                                    Opacity="0" IsHitTestVisible="False" />
                            <Border x:Name="FocusOverlay"
                                    Background="{DynamicResource ColorBrushInputFocusBg}"
                                    BorderBrush="{DynamicResource ColorBrushInputFocusBorder}"
                                    BorderThickness="1" CornerRadius="5"
                                    Opacity="0" IsHitTestVisible="False" />
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="4.5,4.5,0,4.5"
                                          HorizontalScrollBarVisibility="Hidden"
                                          RenderOptions.ClearTypeHint="Enabled" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                            Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.1" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                            Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FocusOverlay"
                                            Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.1" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FocusOverlay"
                                            Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource ColorBrushGray5}" />
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource ColorBrushGray6}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="PasswordBox" BasedOn="{StaticResource PlainPasswordBox}" />
    <!--
        ZCMCL 补：TextBox 隐式样式。
        上游只给了 Keyed 的 PlainTextBox，没有隐式版本，导致直接写 <TextBox/>
        会回退到 WPF 默认方块边框，与周围 PCL 风格控件割裂。
        同文件的 PasswordBox 反而已有隐式样式，说明这是遗漏而非有意设计。
    -->
    <Style TargetType="TextBox" BasedOn="{StaticResource PlainTextBox}" />

</ResourceDictionary>
